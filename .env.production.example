# Copy this file to .env.production and replace every placeholder before deployment.

MYSQL_DATABASE=app_production
MYSQL_USER=app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# Internal Docker Compose URL used by the Next.js rewrite.
SPRING_API_URL=http://backend:8080
FRONTEND_HOST_PORT=3000

GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.example/spring-auth/login/oauth2/code/google
FRONTEND_BASE_URL=https://your-domain.example
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
