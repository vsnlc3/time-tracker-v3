# Keep these URLs aligned with FRONTEND_HOST_PORT when using a non-default port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/spring-auth/login/oauth2/code/google
FRONTEND_BASE_URL=http://localhost:3000
# Set this to true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Local MySQL defaults. Use strong, external values outside local development.
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST_PORT=3306
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
